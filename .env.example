# API
# Local Compose uses postgresql+asyncpg://. Railway may inject postgres:// —
# the API rewrites that to postgresql+asyncpg:// automatically.
DATABASE_URL=postgresql+asyncpg://identity:identity@localhost:5432/identity
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production-use-a-long-random-string
# Local/scripts: true. Railway: false (use seed or admin Clients instead).
ENABLE_DEV_OAUTH_CLIENTS=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=
SESSION_TTL_SECONDS=604800
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# WebAuthn (localhost for local dev; set production RP ID/origins later)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Identity Platform
WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:5174

# Seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=AdminPassword123!

# Demo OAuth client (apps/demo)
DEMO_CLIENT_ID=demo-app
DEMO_CLIENT_NAME=Fieldkit Demo
DEMO_REDIRECT_URI=http://localhost:5174/callback
# Frontends (local only). Docker/Railway: empty VITE_API_URL + VITE_BASE=/demo/.
VITE_DEMO_CLIENT_ID=demo-app
VITE_DEMO_REDIRECT_URI=http://localhost:5174/callback
VITE_API_URL=http://localhost:8000
