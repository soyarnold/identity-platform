# Copy to .env and fill in. Local Compose defaults are documented in README.
# Railway: set these in the service UI — do not copy VITE_* to Railway.

# API
DATABASE_URL=
REDIS_URL=
SECRET_KEY=
ENABLE_DEV_OAUTH_CLIENTS=
CORS_ORIGINS=
FRONTEND_URL=
COOKIE_DOMAIN=
COOKIE_SECURE=
SESSION_TTL_SECONDS=
ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_TTL_SECONDS=

# WebAuthn
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_ORIGINS=

# Seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Demo OAuth client (API seed)
DEMO_CLIENT_ID=
DEMO_CLIENT_NAME=
DEMO_REDIRECT_URI=

# Frontends (local Vite only — Dockerfile sets these for Railway builds)
VITE_API_URL=
VITE_DEMO_CLIENT_ID=
VITE_DEMO_REDIRECT_URI=
